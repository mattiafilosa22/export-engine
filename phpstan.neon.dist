includes:
    # Note: larastan 1.x's extension.neon sets checkGenericClassInNonGenericObjectType,
    # an option deprecated in phpstan 1.10+. The warning is upstream (not suppressible
    # without patching vendor) and is not an error: 'analyse' still exits 0.
    - ./vendor/nunomaduro/larastan/extension.neon

parameters:
    level: 5

    paths:
        - app
        - routes
        - database

    # PHPStan analyzes the code as on the target runtime.
    phpVersion: 70333

    excludePaths:
        # "inspire" closure with $this bound at runtime by the command (false positive).
        - ./routes/console.php
        - ./bootstrap/cache/*
        - ./storage/*
